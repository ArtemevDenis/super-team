{
  "name": "team-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build && npm --prefix server run build",
    "start": "npm --prefix server run start",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "migrate": "npm --prefix server run migrate",
    "seed": "npm --prefix server run seed",
    "studio": "npm --prefix server run studio",
    "test": "npm --prefix server run test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
